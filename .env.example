# HL Activity — exemplo de ambiente
NODE_ENV=production
PORT=3000

# Discord Activity / OAuth (deixe vazio se nao usar a Activity do Discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Origens extras permitidas, separadas por virgula.
# Ex.: https://hl.example.com,https://outro.example.com
HL_ALLOWED_ORIGINS=

# Optional TURN relay for restrictive NATs
TURN_URL=
# Prefer TURN_SHARED_SECRET with coturn REST auth for 1-hour credentials.
TURN_SHARED_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=

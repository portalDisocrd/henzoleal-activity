NODE_ENV=development
PORT=3000

# Discord Activity / OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Preparado para futura configuracao TURN no cliente/servidor.
# Nao coloque credenciais reais no Git.
TURN_URL=

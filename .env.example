# HL Activity — exemplo de ambiente
NODE_ENV=production
PORT=3000

# Discord Activity / OAuth (deixe vazio se nao usar a Activity do Discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Origens extras permitidas, separadas por virgula.
# Ex.: https://hl.example.com,https://outro.example.com
HL_ALLOWED_ORIGINS=

# Opcional: somente se um Discord Bot externo for implementado.
DISCORD_BOT_TOKEN=

# Opcional: origens adicionais confiaveis, separadas por virgula.
# O dominio atual do Render/custom domain ja e aceito automaticamente.
HL_ALLOWED_ORIGINS=

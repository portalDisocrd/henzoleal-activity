{
  "name": "hl-activity",
  "version": "12.0.7-foundation.7",
  "description": "HL Activity V12 - core consolidation, unified UI, modular social foundation and stable release pipeline.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "activity:dev": "vite --host 0.0.0.0",
    "activity:build": "vite build && node copy-dist.js",
    "build": "npm run activity:build",
    "check:backend": "node --check server.js && node --check copy-dist.js",
    "check": "npm run check:backend && npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
